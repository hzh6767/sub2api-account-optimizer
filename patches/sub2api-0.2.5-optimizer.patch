+func (s *AccountTestService) processOpenAIOptimizerChatCompletionsStream(c *gin.Context, body io.Reader) error {
+	r := bufio.NewReader(body)
+	for {
+		line, err := r.ReadString('\n')
+		if err != nil && err != io.EOF { return s.sendErrorAndEnd(c, "Chat Completions stream read error") }
+		line = strings.TrimSpace(line)
+		if line != "" && sseDataPrefix.MatchString(line) {
+			dataText := sseDataPrefix.ReplaceAllString(line, "")
+			if dataText != "[DONE]" {
+				var data map[string]any
+				if json.Unmarshal([]byte(dataText), &data) == nil {
+					if e, ok := data["error"].(map[string]any); ok { if msg, ok := e["message"].(string); ok && msg != "" { return s.sendErrorAndEnd(c, msg) }; return s.sendErrorAndEnd(c, "Chat Completions API returned an error") }
+					if choices, ok := data["choices"].([]any); ok { for _, v := range choices { if ch, ok := v.(map[string]any); ok { if d, ok := ch["delta"].(map[string]any); ok { if t, ok := d["content"].(string); ok && t != "" { s.sendEvent(c, TestEvent{Type:"content", Text:t}); return nil } } } } }
+				}
+			}
+		}
+		if err == io.EOF { return s.sendErrorAndEnd(c, "Chat Completions stream ended before first text token") }
+	}
+}
