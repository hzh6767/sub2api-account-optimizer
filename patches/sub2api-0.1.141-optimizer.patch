+					case "response.failed":
+						return s.sendErrorAndEnd(c, "OpenAI response failed")
+					case "error":
+						return s.sendErrorAndEnd(c, "OpenAI response returned an error")
+					}
+				}
+			}
+		}
+
+		if err == io.EOF {
+			return s.sendErrorAndEnd(c, "Stream ended before first text token")
+		}
+	}
+}
