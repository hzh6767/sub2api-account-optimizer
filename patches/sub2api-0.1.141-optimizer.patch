+import "testing"
+
+func TestAccountHandlerTestRecoveryPolicySkipsOptimizerMode(t *testing.T) {
+	tests := []struct {
+		mode string
+		want bool
+	}{
+		{mode: "", want: true},
+		{mode: "default", want: true},
+		{mode: "compact", want: true},
+		{mode: "optimizer", want: false},
+		{mode: " OPTIMIZER ", want: false},
+	}
+
+	for _, test := range tests {
+		if got := shouldRecoverAfterAccountTest(test.mode); got != test.want {
+			t.Fatalf("shouldRecoverAfterAccountTest(%q) = %v, want %v", test.mode, got, test.want)
+		}
+	}
+}
